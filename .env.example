# Only used when the macOS Keychain is unavailable.
# The preferred source is the Keychain item "opencode-dingtalk-client-secret".
#   security add-generic-password -U -a "$USER" -s opencode-dingtalk-client-secret -w '<secret>'
#
# clientId / robotCode are not credentials, but they identify your DingTalk
# app — replace them with your own values (or keep them in config.json).
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
NO_PROXY=localhost,127.0.0.1,::1
